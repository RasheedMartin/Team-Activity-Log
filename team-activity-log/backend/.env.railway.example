# Copy to .env.railway (git-ignored) and fill in from your Railway services' Variables tabs.
# Use the PUBLIC endpoints: *.railway.internal hostnames only resolve inside Railway.
# Check it with:  TAL_ENV_FILE=.env.railway .venv/bin/tal check

# Postgres service -> Variables -> DATABASE_PUBLIC_URL
PGUSER=
PGPASSWORD=
PGDATABASE=
PGHOST=
PGPORT=

DATABASE_URL=postgresql://postgres:${PGPASSWORD}@${PGHOST}:${PGPORT}/${PGDATABASE}

# Elasticsearch service -> its public TCP proxy (Settings -> Networking) and credentials
Elasticsearch.RAILWAY_PUBLIC_DOMAIN=
Elasticsearch.PORT=
ELASTICSEARCH_URL=http://${Elasticsearch.RAILWAY_PUBLIC_DOMAIN}:${Elasticsearch.PORT}
# Prefer an API key scoped to tal_* indices; otherwise the elastic user:
# ELASTICSEARCH_API_KEY=
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
# ELASTICSEARCH_VERIFY_CERTS=false     # only if the proxy serves a self-signed certificate

# Bucket -> Credentials (Railway Buckets are S3-compatible)
STORAGE=
S3_ENDPOINT=
S3_BUCKET=  
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

ENV=production
DEV_MODE=false
DEV_ALLOW_RESET=false

# ---- Free trial and billing (docs/PRICING.md) ----
# New organizations get Team free for this many days (0 = no trial). No card needed.
TRIAL_DAYS=14
# Stripe: billing stays off until the secret key, webhook secret, and at least one price are set.
# Use test-mode keys (sk_test_…) until you're ready to charge. See backend/README.md → Billing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_TEAM_MONTH=
STRIPE_PRICE_TEAM_YEAR=
STRIPE_PRICE_BUSINESS_MONTH=
STRIPE_PRICE_BUSINESS_YEAR=

# ---- Text in images (OCR) ----
# Built in: Tesseract (installed in the Docker image; `brew install tesseract` locally). New images are
# queued and read in the background. Business orgs can connect Google/Azure/AWS with their own key.
OCR_ENABLED=true
OCR_LANGUAGES=eng
# Encrypts stored third-party keys (an org's cloud OCR key). Required in production before anyone
# saves one. Long random string, e.g. `openssl rand -hex 32`; changing it makes saved keys unreadable.
SECRET_KEY=

# ---- Testing mode (before launch) ----
# Pricing, trials, and upgrades stay hidden until true; every org is on Free with its limits.
PRICING_PUBLIC=false
# If set, new accounts (email or Google) need this code; invited people never do.
SIGNUP_CODE=
