# Copy to .env and fill in. Only the first two blocks are required.

# ---- Postgres (system of record). Any libpq URL; add ?sslmode=require for most hosted providers.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# ---- Elasticsearch 8.x (search). Either a URL or an Elastic Cloud ID, plus an API key
# (or ELASTICSEARCH_USERNAME / ELASTICSEARCH_PASSWORD).
ELASTICSEARCH_URL=https://HOST:443
# ELASTICSEARCH_CLOUD_ID=
ELASTICSEARCH_API_KEY=
# ELASTICSEARCH_CA_CERTS=/path/to/ca.pem      # self-signed clusters
# ELASTICSEARCH_INDEX_PREFIX=tal              # lets several environments share one cluster

# ---- App
ENV=production                                 # development | test | production
DEV_MODE=false                                 # /v1/dev/* persona tools; refused in production
CORS_ORIGINS=["https://app.example.com"]
PUBLIC_APP_URL=https://app.example.com
# FRONTEND_DIST=../frontend/dist               # serve the built UI from this API (same origin)
# RUN_INDEXER=true                             # set false if you run `tal worker` separately
