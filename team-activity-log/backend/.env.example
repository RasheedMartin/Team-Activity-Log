# Copy to .env and fill in. Only the first two blocks are required.

# ---- Postgres (system of record). Any libpq URL; add ?sslmode=require for most hosted providers.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# ---- Elasticsearch 8.x (search). Either a URL or an Elastic Cloud ID, plus an API key
# (or ELASTICSEARCH_USERNAME / ELASTICSEARCH_PASSWORD).
ELASTICSEARCH_URL=https://HOST:443
# ELASTICSEARCH_CLOUD_ID=
ELASTICSEARCH_API_KEY=
# ELASTICSEARCH_CA_CERTS=/path/to/ca.pem      # self-signed clusters
# ELASTICSEARCH_INDEX_PREFIX=tal              # lets several environments share one cluster

# ---- App
ENV=production                                 # development | test | production
DEV_MODE=false                                 # /v1/dev/* persona tools; refused in production
CORS_ORIGINS=["https://app.example.com"]
PUBLIC_APP_URL=https://app.example.com
# FRONTEND_DIST=../frontend/dist               # serve the built UI from this API (same origin)
# RUN_INDEXER=true                             # set false if you run `tal worker` separately

# ---- Email (Resend or Postmark API; EMAIL_PROVIDER=log keeps them on /dev without sending)
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=Team Activity Log <noreply@yourdomain.com>   # domain must be verified with the provider

# ---- Sign in with Google (Google Cloud Console -> Credentials -> OAuth client ID, Web application)
# Authorized redirect URI: <PUBLIC_APP_URL>/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Free trial and billing (docs/PRICING.md) ----
# New organizations get Team free for this many days (0 = no trial). No card needed.
TRIAL_DAYS=14
# Stripe: billing stays off until the secret key, webhook secret, and at least one price are set.
# Use test-mode keys (sk_test_…) until you're ready to charge. See backend/README.md → Billing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_TEAM_MONTH=
STRIPE_PRICE_TEAM_YEAR=
STRIPE_PRICE_BUSINESS_MONTH=
STRIPE_PRICE_BUSINESS_YEAR=

# ---- Text in images (OCR) ----
# Built in: Tesseract (installed in the Docker image; `brew install tesseract` locally). New images are
# queued and read in the background. Business orgs can connect Google/Azure/AWS with their own key.
OCR_ENABLED=true
OCR_LANGUAGES=eng
# Encrypts stored third-party keys (an org's cloud OCR key). Required in production before anyone
# saves one. Long random string, e.g. `openssl rand -hex 32`; changing it makes saved keys unreadable.
SECRET_KEY=

# ---- Testing mode (before launch) ----
# Pricing, trials, and upgrades stay hidden until true; every org is on Free with its limits.
PRICING_PUBLIC=false
# If set, new accounts (email or Google) need this code; invited people never do.
SIGNUP_CODE=

# ---- Super admin ----
# Verified accounts that can open /super (every org; delete an org with its data). JSON list.
SUPERADMIN_EMAILS=[]
# Lets super admins delete ALL data. Leave false; turn on only for a deliberate reset, then off.
ALLOW_WIPE=false
